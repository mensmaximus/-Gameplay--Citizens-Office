<ModOps>
  <ImyaTweaks Title="Select influence area for the Citizens Office" />
  <Group ModOpID="co_influence">

    <ModOp Type="merge"
      GUID="1337477301,1337477304,1337477307,1337477310,1337477501,1337477504,1337477507,1337477510"
      Path="/Values/ItemContainer">
      <SocketScope>Session</SocketScope>
    </ModOp>

    <!-- old version with guids
    <ModOp Type="merge"
    GUID="1337477300,1337477303,1337477306,1337477309,1337477500,1337477503,1337477506,1337477509"
    Path="/Values/Standard">
      <InfoDescription>1337477448</InfoDescription>
    </ModOp>
    -->
    <ModOp Type="merge" Path="//Asset[Template='CitizenOffice']/Values/Standard">
      <InfoDescription>1337477448</InfoDescription>
    </ModOp>

    <!-- old version with guids and BuildingUnique node in the assets
      <ModOp Type="merge"
    GUID="1337477300,1337477303,1337477306,1337477309,1337477500,1337477503,1337477506,1337477509"
    Path="/Values/BuildingUnique/Uniques/Item">
        <UniqueScope>Session</UniqueScope>
      </ModOp>
      -->
    <ModOp Type="merge" Path="//Asset[Template='CitizenOffice']/Values">
      <BuildingUnique>
        <Uniques>
          <Item>
            <UniqueType>Mod20</UniqueType>
            <UniqueScope>Session</UniqueScope>
          </Item>
        </Uniques>
      </BuildingUnique>
    </ModOp>

    <!-- not working
    <ModOp Type="merge" Path="//Template[Name='CitizenOffice']/Properties/BuildingUnique/Uniques/Item">
      <UniqueScope>Session</UniqueScope>
    </ModOp>
    -->

  </Group>
  <ImyaExpose Path="*" ModOpID="co_influence" ExposeID="Area or Session"
    Description="Enable to activate session wide influence of items. Otherwise items influence the current island. ** Change before you start a new game. Never change it in a savegame! see readme file **"
    Kind="SkipToggle" InitState="False">
  </ImyaExpose>
</ModOps>